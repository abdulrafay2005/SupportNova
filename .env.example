# SupportNova environment configuration (EXAMPLE)
# Copy to `.env` and fill in real values. Never commit the real `.env`.
# This file lists variable NAMES only — do not put secrets here.

# --- Database (required) ---
# MongoDB connection string. Database name used by the app is "supportnova".
MONGO_URI=

# --- Authentication (required) ---
# Secret used to sign JWT access tokens. Use a long, random value.
JWT_SECRET_KEY=

# --- Login lockout (optional; defaults shown as comments) ---
# Consecutive failed logins before an account is temporarily locked. Default: 5
LOGIN_MAX_FAILED_ATTEMPTS=
# Lockout cooldown in minutes once the threshold is reached. Default: 15
LOGIN_LOCKOUT_MINUTES=

# --- CORS (optional) ---
# Comma-separated list of allowed browser origins for the API.
# Default: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=

# --- GenAI / OpenAI (optional; deterministic pipeline runs without it) ---
# Set to "true" to enable optional AI enrichment. Default: false (disabled).
OPENAI_ENABLED=
# API key, required ONLY when OPENAI_ENABLED=true.
OPENAI_API_KEY=
